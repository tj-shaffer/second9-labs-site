# Local-dev secrets template for `wrangler dev`. Copy to `.dev.vars`
# (gitignored) and fill in real values. Production uses `wrangler secret put`.

# --- Phase 3 + 4 (v1) ---
GEMINI_API_KEY=               # Gemini 2.5 Flash for conversational drive + Imagen 3 image gen
SPOONACULAR_API_KEY=          # Phase 6: demoted to background cross-reference

# --- Phase 5 (magic-link auth) ---
RESEND_API_KEY=               # Resend transactional email for magic-link sign-in
SESSION_SECRET=               # Random 32+ bytes, hex or base64; signs session cookies
EMAIL_FROM=                   # e.g. "Biba's Kitchen <hi@your-domain.com>"

# --- Phase 9 (auth modernization — Google OAuth primary) ---
GOOGLE_CLIENT_ID=             # console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_SECRET=         # paired secret from the same OAuth client
                              # Authorized redirect URIs to add in Google console:
                              #   http://localhost:8787/api/auth/google/callback   (dev)
                              #   https://<your-domain>/api/auth/google/callback   (prod)

# --- Phase 6 (Kitchen OS — recipe brain swap) ---
ANTHROPIC_API_KEY=            # Claude Opus 4.7 — primary recipe author
# RECIPE_AUTHOR=gemini        # Uncomment to force Gemini 2.5 Pro as the author
                              # (reuses GEMINI_API_KEY; useful if Anthropic
                              # credits are unavailable or you want cheaper).
EDAMAM_APP_ID=                # Edamam Recipe Search API — cross-reference
EDAMAM_APP_KEY=               # Edamam Recipe Search API — cross-reference
RAPID_API_KEY=                # Tasty via RapidAPI — cross-reference

# --- Phase 7 (Memory foundation — Vectorize RAG) ---
# No secrets — Workers AI + Vectorize bindings live in wrangler.jsonc.
# Before deploy, provision the Vectorize indexes once:
#   npx wrangler vectorize create biba-memory-conversations --dimensions=768 --metric=cosine
#   npx wrangler vectorize create biba-memory-recipes       --dimensions=768 --metric=cosine
#   npx wrangler vectorize create-metadata-index biba-memory-conversations --property-name=email --type=string
#   npx wrangler vectorize create-metadata-index biba-memory-recipes       --property-name=email --type=string

# --- Phase 8 (Personal cookbook ingestion) ---
# One more Vectorize index for the personal-corpus chunks:
#   npx wrangler vectorize create biba-memory-corpus --dimensions=768 --metric=cosine
#   npx wrangler vectorize create-metadata-index biba-memory-corpus --property-name=email --type=string

# --- Phase 10 (Computer-use agent — vault + Browser Rendering) ---
VAULT_MASTER_KEY=             # Base64 of 32+ random bytes. Local: generate with
                              #   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
                              # Prod: never reuse local key; wrangler secret put VAULT_MASTER_KEY
# Cloudflare resources to flip the agent from dry-run to live:
#   - Workers Paid plan ($5/mo)
#   - Browser Rendering enabled on the account
#   - Uncomment the "browser" binding in wrangler.jsonc
#   - Add @cloudflare/puppeteer as a runtime dependency:
#       npm install @cloudflare/puppeteer
#   - Real Anthropic credits (Claude Computer Use is paid usage)

# --- Future (when Instacart IDP approval lands) ---
# INSTACART_API_KEY=          # Auto-upgrades the Instacart provider from search-URL to real cart

