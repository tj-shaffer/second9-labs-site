{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "second-9-labs",
  "main": "worker/index.js",
  "compatibility_date": "2026-04-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // KV for per-user profile, sessions, magic-link tokens, recipe history.
  // For local dev, miniflare uses a SQLite-backed simulation — the `id` value
  // is only meaningful when deploying. Before `npm run deploy`, run:
  //   npx wrangler kv namespace create biba_users
  // and paste the returned id below.
  "kv_namespaces": [
    {
      "binding": "BIBA_USERS",
      "id": "local-dev-placeholder-replace-before-deploy"
    }
  ],
  // R2 bucket for Imagen-3-generated recipe photos (Phase 6).
  // Cache keyed by sha256(title|image_prompt); first generation only,
  // re-served from R2 forever after. Provision once with:
  //   npx wrangler r2 bucket create biba-recipe-images
  "r2_buckets": [
    {
      "binding": "BIBA_RECIPE_IMAGES",
      "bucket_name": "biba-recipe-images"
    }
  ]
}
