{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "second-9-labs",
	"compatibility_date": "2026-04-21",
	// Static marketing site — assets-only, no Worker script.
	// The recipes app (Biba's Playground) was extracted to its own
	// repo/subdomain on 2026-06-24; its Worker + KV/R2/Vectorize/AI
	// bindings and secrets moved with it. See git history before that
	// date if any of the deleted backend needs reviving.
	"assets": {
		"directory": "./public"
	}
}
